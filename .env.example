# Required
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
BQ_LOCATION=US

# Models (see src/datapilot/config.py for defaults)
DATAPILOT_MODEL=gemini-2.5-flash
DATAPILOT_EMBEDDING_MODEL=gemini-embedding-001

# Optional overrides
# DATAPILOT_DATA_DIR=./data
# DATAPILOT_API_URL=http://localhost:8080
# DATAPILOT_WEBHOOK_TOKEN=change-me

# Auth: run `gcloud auth application-default login` locally instead of a key file.
