FROM apache/airflow:2.10.2-python3.11

USER root
COPY pyproject.toml /opt/datapilot/pyproject.toml
COPY src /opt/datapilot/src
COPY configs /opt/datapilot/configs
COPY sql /opt/datapilot/sql
RUN chown -R airflow:root /opt/datapilot

USER airflow
RUN pip install --no-cache-dir -e /opt/datapilot \
    && pip install --no-cache-dir google-adk google-genai
